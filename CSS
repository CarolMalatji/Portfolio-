:root {
    --gold: #C9A050;
    --dark: #222;
    --light-gray: #f9f9f9;
    --border: #e0e0e0;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Arial, sans-serif;
}

body { color: #333; line-height: 1.6; }

/* Navigation */
header {
    padding: 20px 5%;
    border-bottom: 1px solid var(--border);
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo { display: flex; align-items: center; gap: 10px; }
.logo-box {
    border: 2px solid var(--gold);
    color: var(--gold);
    padding: 5px 10px;
    font-weight: bold;
    font-size: 1.2rem;
}

.logo-text span { display: block; line-height: 1.1; }
.main-name { font-weight: bold; font-size: 0.9rem; color: var(--dark); }
.sub-name { color: var(--gold); font-size: 0.8rem; font-weight: bold; }

nav ul { display: flex; list-style: none; gap: 20px; }
nav ul li a { text-decoration: none; color: #555; font-size: 0.9rem; font-weight: 500; }

/* Buttons */
.btn {
    padding: 10px 20px;
    text-decoration: none;
    font-weight: bold;
    font-size: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: 0.3s;
}

.btn-outline { border: 1px solid var(--gold); color: var(--gold); }
.btn-filled { background: var(--gold); color: white; border: none; cursor: pointer; }
.btn-outline-gold { border: 1px solid var(--gold); color: var(--dark); }

/* Hero */
.hero {
    display: flex;
    padding: 80px 10%;
    align-items: center;
    gap: 50px;
}

.hero-content { flex: 1; }
.greeting { color: var(--gold); font-weight: bold; font-size: 0.9rem; margin-bottom: 5px; }
h1 { font-size: 3.5rem; margin-bottom: 10px; }
.gold-text { color: var(--gold); }
.subtitle { font-weight: bold; letter-spacing: 2px; margin-bottom: 20px; color: var(--dark); }
.bio-intro { color: #666; margin-bottom: 30px; max-width: 500px; }

.hero-btns { display: flex; gap: 15px; margin-bottom: 30px; }
.social-links { display: flex; gap: 15px; }
.social-links i {
    font-size: 1.2rem;
    color: var(--gold);
    border: 1px solid var(--border);
    padding: 10px;
    border-radius: 50%;
}

.image-circle {
    width: 350px;
    height: 350px;
    border: 2px solid var(--gold);
    border-radius: 50%;
}

/* Sections */
.info-section { padding: 60px 10%; border-top: 1px solid var(--border); }
.split-view { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; }
.section-title { font-size: 1rem; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
.section-title i { color: var(--gold); }

/* Timeline */
.timeline { border-left: 1px solid var(--gold); padding-left: 20px; margin-top: 20px; }
.timeline-item { position: relative; margin-bottom: 30px; }
.dot {
    position: absolute;
    left: -27px;
    top: 5px;
    width: 12px;
    height: 12px;
    background: white;
    border: 2px solid var(--gold);
    border-radius: 50%;
}
.year { color: var(--gold); font-weight: bold; font-size: 0.9rem; }
.small { font-size: 0.8rem; color: #777; }

/* Skills */
.center-title { text-align: center; margin: 60px 0 30px; font-size: 1.2rem; }
.skills-container { display: flex; justify-content: center; gap: 40px; padding: 0 10%; }
.skill-group h3 { font-size: 0.8rem; color: var(--gold); text-align: center; margin-bottom: 15px; }
.skill-grid { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
.skill-box { border: 1px solid var(--border); padding: 15px 20px; min-width: 100px; text-align: center; font-size: 0.85rem; }

/* Projects */
.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    padding: 20px 10% 60px;
}

.project-card {
    border: 1px solid var(--gold);
    padding: 30px 20px;
    text-align: center;
}

.project-card h3 { font-size: 1rem; margin-bottom: 15px; border-bottom: 1px solid var(--gold); display: inline-block; padding-bottom: 5px;}
.project-card p { font-size: 0.8rem; color: #666; margin-bottom: 10px; }
.tech { font-weight: bold; font-size: 0.8rem; color: #333; margin-bottom: 15px; }
.github-link { color: var(--gold); font-size: 0.7rem; font-weight: bold; text-decoration: none; }

/* Contact */
.social-connect { display: flex; justify-content: center; gap: 40px; padding: 40px 0; border-top: 1px solid var(--border);}
.social-card { display: flex; align-items: center; gap: 15px; }
.social-card i { font-size: 2.5rem; color: var(--gold); }
.mini-btn { background: var(--gold); color: white; text-decoration: none; padding: 5px 10px; font-size: 0.7rem; margin-top: 5px; display: inline-block;}

.contact-container { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 40px; padding: 40px 10%; }
.info-item { display: flex; gap: 15px; margin-bottom: 20px; font-size: 0.85rem; }
.info-item i { color: var(--gold); margin-top: 5px;}

.contact-form .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.contact-form input, .contact-form textarea {
    width: 100%;
    padding: 12px;
    margin-bottom: 10px;
    border: 1px solid var(--border);
    outline: none;
}
.send-btn { width: 100%; justify-content: center; padding: 15px; margin-top: 10px; }

.quote-box { text-align: center; font-size: 0.8rem; font-style: italic; color: #555; position: relative; padding-top: 40px; }
.quote-box i { color: var(--gold); font-size: 1.2rem; }

/* Footer */
footer { background: var(--dark); color: #ccc; text-align: center; padding: 40px 0; font-size: 0.8rem; }
.footer-socials { margin-bottom: 15px; font-size: 1.2rem; color: var(--gold); display: flex; justify-content: center; gap: 15px;}
.heart { color: var(--gold); }

/* Responsive */
@media (max-width: 900px) {
    .hero { flex-direction: column; text-align: center; }
    .split-view, .contact-container, .skills-container { grid-template-columns: 1fr; display: block; }
    .hero-btns { justify-content: center; }
    .image-circle { width: 250px; height: 250px; margin: 0 auto; }
}
