/* General Styles */
:root {
    --gold: #C9A050;
    --dark: #222222;
    --light-gray: #f9f9f9;
    --border-color: #e0e0e0;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    color: #333;
    background-color: #fff;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Header */
header {
    padding: 20px 0;
    border-bottom: 1px solid var(--border-color);
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    align-items: center;
}

.ms-box {
    background-color: transparent;
    border: 2px solid var(--gold);
    color: var(--gold);
    padding: 5px 8px;
    font-weight: bold;
    font-size: 1.2rem;
    margin-right: 10px;
}

.logo-text {
    display: flex;
    flex-direction: column;
}

.name-main { font-weight: bold; color: var(--dark); font-size: 0.9rem; letter-spacing: 1px;}
.name-sub { color: var(--gold); font-size: 0.8rem; font-weight: bold;}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li a {
    text-decoration: none;
    color: #555;
    margin: 0 15px;
    font-size: 0.9rem;
    font-weight: 500;
}

/* Buttons */
.btn {
    padding: 10px 20px;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: bold;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: 0.3s;
}

.btn-outline { border: 1px solid var(--gold); color: var(--gold); }
.btn-filled { background: var(--gold); color: white; border: none; }
.btn-outline-gold { border: 1px solid var(--gold); color: var(--dark); }
.btn-filled:hover { background: #b08d44; }

/* Hero Section */
.hero {
    display: flex;
    align-items: center;
    padding: 80px 20px;
}

.hero-content { flex: 1; }
.hero-image { flex: 1; display: flex; justify-content: flex-end; }

.greeting { color: var(--gold); font-weight: bold; font-size: 0.8rem; margin-bottom: 10px; }
h1 { font-size: 3.5rem; margin-bottom: 5px; color: var(--dark); }
.highlight { color: var(--gold); }
.title-sub { font-weight: bold; letter-spacing: 2px; margin-bottom: 20px; color: var(--dark); }
.description { color: #666; max-width: 500px; margin-bottom: 30px; }

.hero-btns { margin-bottom: 20px; display: flex; gap: 15px; }

.social-icons i {
    font-size: 1.2rem;
    color: var(--gold);
    margin-right: 15px;
    cursor: pointer;
    border: 1px solid var(--border-color);
    padding: 10px;
    border-radius: 50%;
}

.circle-container {
    width: 350px;
    height: 350px;
    border: 2px solid var(--gold);
    border-radius: 50%;
    position: relative;
}

/* Sections Common */
.two-col-section { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; padding: 60px 20px; }
.section-title { font-size: 1.1rem; margin-bottom: 25px; color: var(--dark); display: flex; align-items: center; gap: 10px; }
.section-title i { color: var(--gold); }
.center-title { text-align: center; margin: 50px 0 30px; font-size: 1.3rem; }

/* Timeline */
.timeline { border-left: 1px solid var(--gold); padding-left: 20px; position: relative; }
.timeline-item { margin-bottom: 30px; position: relative; }
.dot { width: 12px; height: 12px; background: white; border: 2px solid var(--gold); border-radius: 50%; position: absolute; left: -27px; top: 5px; }
.year { color: var(--gold); font-weight: bold; margin-bottom: 5px; }
.timeline-item h3 { font-size: 1rem; margin-bottom: 5px; }
.small-text { font-size: 0.85rem; color: #777; }

/* Skills */
.skills-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 50px; }
.skill-group-title { font-size: 0.9rem; color: var(--gold); margin-bottom: 15px; text-align: center; }
.skill-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
.skill-tag { border: 1px solid var(--border-color); padding: 15px 25px; font-size: 0.85rem; font-weight: 500; min-width: 100px; text-align: center; }

/* Projects */
.projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px; }
.project-card { border: 1px solid var(--gold); padding: 30px 20px; text-align: center; transition: 0.3s; }
.project-card:hover { box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
.project-card h3 { font-size: 1rem; margin-bottom: 15px; border-bottom: 1px solid var(--gold); display: inline-block; padding-bottom: 5px; }
.project-card p { font-size: 0.85rem; color: #666; margin-bottom: 15px; }
.tech-stack { color: var(--dark) !important; font-weight: 500; }
.github-link { font-size: 0.75rem; text-decoration: none; color: var(--gold); font-weight: bold; }

/* Contact Section */
.contact-flex { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 30px; align-items: start; margin-bottom: 50px;}
.info-item { display: flex; gap: 15px; margin-bottom: 25px; font-size: 0.9rem; }
.info-item i { color: var(--gold); margin-top: 5px; }

.contact-form .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.contact-form input, .contact-form textarea { width: 100%; padding: 12px; margin-bottom: 10px; border: 1px solid var(--border-color); outline: none; }
.btn-full { width: 100%; justify-content: center; padding: 15px; }

.quote-box { text-align: center; padding: 20px; border-top: 1px solid var(--border-color); margin-top: 50px;}
.quote-box p { font-style: italic; color: #555; margin: 10px 0; font-size: 0.9rem; }

/* Footer */
footer { background: var(--dark); color: white; padding: 40px 0; text-align: center; font-size: 0.8rem; }
.footer-left { margin-bottom: 15px; }
.footer-left a { color: var(--gold); margin: 0 10px; font-size: 1.2rem; }
footer p { margin-bottom: 5px; color: #aaa; }

/* Responsive */
@media (max-width: 768px) {
    .nav-container nav, .download-cv-top { display: none; }
    .hero { flex-direction: column; text-align: center; }
    .hero-image { display: none; }
    .two-col-section, .skills-grid, .contact-flex { grid-template-columns: 1fr; }
    h1 { font-size: 2.5rem; }
}
